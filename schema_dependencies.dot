// schema_dependencies.dot
// Graphviz DOT file showing foreign-key dependencies for the schema in `setup.sql`.
// Edges point from dependent table -> referenced table (i.e., "depends on" -> referenced).

digraph schema_dependencies {
  rankdir=LR;
  node [shape=box, fontname="Helvetica"];

  Genres [label="Genres\n- genre_id PK"];
  Artists [label="Artists\n- artist_id PK\n- genre_id FK: Genres.genre_id"];
  Albums [label="Albums\n- album_id PK\n- artist_id FK: Artists.artist_id\n- genre_id FK: Genres.genre_id"];
  Tracks [label="Tracks\n- track_id PK\n- album_id FK: Albums.album_id\n- artist_id FK: Artists.artist_id\n- genre_id FK: Genres.genre_id"];
  AudioFeatures [label="AudioFeatures\n- feature_id PK\n- track_id FK: Tracks.track_id"];
  Users [label="Users\n- user_id PK\n- genre_id FK: Genres.genre_id\n- artist_id FK: Artists.artist_id"];

  // Foreign-key edges (child -> parent)
  Artists -> Genres;
  Albums -> Artists;
  Albums -> Genres;
  Tracks -> Albums;
  Tracks -> Artists;
  Tracks -> Genres;
  AudioFeatures -> Tracks;
  Users -> Artists;
  Users -> Genres;
}
